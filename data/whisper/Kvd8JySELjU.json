				"to": "00:05:34,640"
			},
			"offsets": {
				"from": 331180,
				"to": 334640
			},
			"text": " Especially this time of the year."
		},
		{
			"timestamps": {
				"from": "00:05:34,700",
				"to": "00:05:38,720"
			},
			"offsets": {
				"from": 334700,
				"to": 338720
			},
			"text": " Let's tell it a story that people will understand."
		},
		{
			"timestamps": {
				"from": "00:05:38,720",
				"to": "00:05:43,100"
			},
			"offsets": {
				"from": 338720,
				"to": 343100
			},
			"text": " And so, I want to probably go through some pretty basic verses."
		},
		{
			"timestamps": {
				"from": "00:05:43,100",
				"to": "00:05:45,260"
			},
			"offsets": {
				"from": 343100,
				"to": 345260
			},
			"text": " You'll recognize it."
		},
		{
			"timestamps": {
				"from": "00:05:45,260",
				"to": "00:05:49,700"
			},
			"offsets": {
				"from": 345260,
				"to": 349700
			},
			"text": " But read it with the advent of love in mind."
		},
		{
			"timestamps": {
				"from": "00:05:49,700",
				"to": "00:05:51,240"
			},
			"offsets": {
				"from": 349700,
				"to": 351240
			},
			"text": " Psalm 316."
		},
		{
			"timestamps": {
				"from": "00:05:51,240",
				"to": "00:05:51,760"
			},
			"offsets": {
				"from": 351240,
				"to": 351760
			},
			"text": " Psalm 316."
		},
		{
			"timestamps": {
				"from": "00:05:51,760",
				"to": "00:05:58,500"
			},
			"offsets": {
				"from": 351760,
				"to": 358500
			},
			"text": " For God, the creator of all, so loved the world."
		},
		{
			"timestamps": {
				"from": "00:05:58,500",
				"to": "00:06:01,880"
			},
			"offsets": {
				"from": 358500,
				"to": 361880
			},
			"text": " He gave him his one and only son."
		},
		{
			"timestamps": {
				"from": "00:06:01,880",
				"to": "00:06:08,240"
			},
			"offsets": {
				"from": 361880,
				"to": 368240
			},
			"text": " And whoever believes in him will not pray, but how he can love us."
		},
		{
			"timestamps": {
				"from": "00:06:08,240",
				"to": "00:06:10,000"
			},
			"offsets": {
				"from": 368240,
				"to": 370000
			},
			"text": " Amen."
		},
		{
			"timestamps": {
				"from": "00:06:10,000",
				"to": "00:06:15,160"
			},
			"offsets": {
				"from": 370000,
				"to": 375160
			},
			"text": " God, so loved the world."
		},
		{
			"timestamps": {
				"from": "00:06:16,200",
				"to": "00:06:19,480"
			},
			"offsets": {
				"from": 376200,
				"to": 379480
			},
			"text": " And I love how John details this out."
		},
		{
			"timestamps": {
				"from": "00:06:19,480",
				"to": "00:06:23,000"
			},
			"offsets": {
				"from": 379480,
				"to": 383000
			},
			"text": " Later on, 1 John 4, 19-12."
		},
		{
			"timestamps": {
				"from": "00:06:23,000",
				"to": "00:06:23,840"
			},
			"offsets": {
				"from": 383000,
				"to": 383840
			},
			"text": " Let me read this to you."
		},
		{
			"timestamps": {
				"from": "00:06:23,840",
				"to": "00:06:26,940"
			},
			"offsets": {
				"from": 383840,
				"to": 386940
			},
			"text": " This is him just taking a little deeper on it."
		},
		{
			"timestamps": {
				"from": "00:06:26,940",
				"to": "00:06:32,360"
			},
			"offsets": {
				"from": 386940,
				"to": 392360
			},
			"text": " Because this is how God showed his love among us."
		},
		{
			"timestamps": {
				"from": "00:06:32,360",
				"to": "00:06:33,580"
			},
			"offsets": {
				"from": 392360,
				"to": 393580
			},
			"text": " It's pretty clear."
		},
		{
			"timestamps": {
				"from": "00:06:33,680",
				"to": "00:06:35,200"
			},
			"offsets": {
				"from": 393680,
				"to": 395200
			},
			"text": " This is how he saves his love."
		},
		{
			"timestamps": {
				"from": "00:06:35,200",
				"to": "00:06:41,860"
			},
			"offsets": {
				"from": 395200,
				"to": 401860
			},
			"text": " He sent his one and only son into the world that we might live through him."
		},
		{
			"timestamps": {
				"from": "00:06:41,860",
				"to": "00:06:43,840"
			},
			"offsets": {
				"from": 401860,
				"to": 403840
			},
			"text": " This is love."
		},
		{
			"timestamps": {
				"from": "00:06:43,840",
				"to": "00:06:45,860"
			},
			"offsets": {
				"from": 403840,
				"to": 405860
			},
			"text": " Make that we have loved God."
		},
		{
			"timestamps": {
				"from": "00:06:45,860",
				"to": "00:06:53,820"
			},
			"offsets": {
				"from": 405860,
				"to": 413820
			},
			"text": " Because he loved us and sent his son as an atoning sacrifice for us."
		},
		{
			"timestamps": {
				"from": "00:06:53,820",
				"to": "00:07:02,020"
			},
			"offsets": {
				"from": 413820,
				"to": 422020
			},
			"text": " Friends, dear friends, since God so loved us, we also have to love one another."
		},
		{
			"timestamps": {
				"from": "00:07:02,020",
				"to": "00:07:05,160"
			},
			"offsets": {
				"from": 422020,
				"to": 425160
			},
			"text": " No one has ever seen God."
		},
		{
			"timestamps": {
				"from": "00:07:05,160",
				"to": "00:07:13,780"
			},
			"offsets": {
				"from": 425160,
				"to": 433780
			},
			"text": " But if we love one another, God lives in us and his love is made to preach to us."
		},
		{
			"timestamps": {
				"from": "00:07:13,780",
				"to": "00:07:17,920"
			},
			"offsets": {
				"from": 433780,
				"to": 437920
			},
			"text": " And that's God's love is part."
		},
		{
			"timestamps": {
				"from": "00:07:17,920",
				"to": "00:07:22,280"
			},
			"offsets": {
				"from": 437920,
				"to": 442280
			},
			"text": " His love is part, I think, is so important."
		},
		{
			"timestamps": {
				"from": "00:07:23,280",
				"to": "00:07:27,900"
			},
			"offsets": {
				"from": 443280,
				"to": 447900
			},
			"text": " His love is made to preach to us."
		},
		{
			"timestamps": {
				"from": "00:07:27,900",
				"to": "00:07:37,160"
			},
			"offsets": {
				"from": 447900,
				"to": 457160
			},
			"text": " So if we dress your feet, God's love, and we kind of tip it to ourselves,"
		},
		{
			"timestamps": {
				"from": "00:07:37,160",
				"to": "00:07:41,940"
			},
			"offsets": {
				"from": 457160,
				"to": 461940
			},
			"text": " we're not a thing that makes part about responding in love to others."
		},
		{
			"timestamps": {
				"from": "00:07:41,940",
				"to": "00:07:45,360"
			},
			"offsets": {
				"from": 461940,
				"to": 465360
			},
			"text": " There's something incomplete."
		},
		{
			"timestamps": {
				"from": "00:07:45,360",
				"to": "00:07:47,580"
			},
			"offsets": {
				"from": 465360,
				"to": 467580
			},
			"text": " There's something missing."
		},
		{
			"timestamps": {
				"from": "00:07:47,580",
				"to": "00:07:49,880"
			},
			"offsets": {
				"from": 467580,
				"to": 469880
			},
			"text": " So God goes on."
		},
		{
			"timestamps": {
				"from": "00:07:50,460",
				"to": "00:07:53,360"
			},
			"offsets": {
				"from": 470460,
				"to": 473360
			},
			"text": " I think we're supposed to experience God's love."
		},
		{
			"timestamps": {
				"from": "00:07:53,360",
				"to": "00:07:55,480"
			},
			"offsets": {
				"from": 473360,
				"to": 475480
			},
			"text": " We don't have to understand his love for us."
		},
		{
			"timestamps": {
				"from": "00:07:55,480",
				"to": "00:07:58,060"
			},
			"offsets": {
				"from": 475480,
				"to": 478060
			},
			"text": " We have to experience his love for us."
		},
		{
			"timestamps": {
				"from": "00:07:58,060",
				"to": "00:08:00,700"
			},
			"offsets": {
				"from": 478060,
				"to": 480700
			},
			"text": " And one day is a response."
		},
		{
			"timestamps": {
				"from": "00:08:00,700",
				"to": "00:08:03,380"
			},
			"offsets": {
				"from": 480700,
				"to": 483380
			},
			"text": " And I think it's kind of proportional."
		},
		{
			"timestamps": {
				"from": "00:08:03,380",
				"to": "00:08:07,400"
			},
			"offsets": {
				"from": 483380,
				"to": 487400
			},
			"text": " So when we talk about growing in our faith throughout our lives,"
		},
		{
			"timestamps": {
				"from": "00:08:07,400",
				"to": "00:08:09,700"
			},
			"offsets": {
				"from": 487400,
				"to": 489700
			},
			"text": " I think this is one of the ways that happens."
		},
		{
			"timestamps": {
				"from": "00:08:10,820",
				"to": "00:08:15,480"
			},
			"offsets": {
				"from": 490820,
				"to": 495480
			},
			"text": " The more we understand and experience God's love for us, for me,"
		},
		{
			"timestamps": {
				"from": "00:08:15,480",
				"to": "00:08:24,940"
			},
			"offsets": {
				"from": 495480,
				"to": 504940
			},
			"text": " then the more we're able and possibly even compelled to serve his love."
		},
		{
			"timestamps": {
				"from": "00:08:26,380",
				"to": "00:08:32,980"
			},
			"offsets": {
				"from": 506380,
				"to": 512980
			},
			"text": " And the more we fear his love, the more complete his love, the worse."
		},
		{
			"timestamps": {
				"from": "00:08:32,980",
				"to": "00:08:42,200"
			},
			"offsets": {
				"from": 512980,
				"to": 522200
			},
			"text": " And we talk to the experience of a cycle of that, and indeed talking about things without works is what?"
		},
		{
			"timestamps": {
				"from": "00:08:42,740",
				"to": "00:08:53,240"
			},
			"offsets": {
				"from": 522740,
				"to": 533240
			},
			"text": " But in some ways, in some ways, in some ways, the most love for us, in us, what we're experiencing,"
		},
		{
			"timestamps": {
				"from": "00:08:53,240",
				"to": "00:09:00,340"
			},
			"offsets": {
				"from": 533240,
				"to": 540340
			},
			"text": " it's incomplete until we take that next step to serve, to demonstrate it."
		},
		{
			"timestamps": {
				"from": "00:09:01,480",
				"to": "00:09:03,520"
			},
			"offsets": {
				"from": 541480,
				"to": 543520
			},
			"text": " And what does that really look like?"
		},
		{
			"timestamps": {
				"from": "00:09:03,520",
				"to": "00:09:05,000"
			},
			"offsets": {
				"from": 543520,
				"to": 545000
			},
			"text": " Let's make it."
		},
		{
			"timestamps": {
				"from": "00:09:05,000",
				"to": "00:09:21,240"
			},
			"offsets": {
				"from": 545000,
				"to": 561240
			},
			"text": " Let's make it a difference for somebody else."
		},
		{
			"timestamps": {
				"from": "00:09:22,520",
				"to": "00:09:29,220"
			},
			"offsets": {
				"from": 562520,
				"to": 569220
			},
			"text": " And when you're doing that because you recognize the fact that you have so picked up its love,"
		},
		{
			"timestamps": {
				"from": "00:09:29,220",
				"to": "00:09:34,020"
			},
			"offsets": {
				"from": 569220,
				"to": 574020
			},
			"text": " you're so blessed, because you're the initial thing,"
		},
		{
			"timestamps": {
				"from": "00:09:34,020",
				"to": "00:09:39,020"
			},
			"offsets": {
				"from": 574020,
				"to": 579020
			},
			"text": " you're going to share that life with somebody else."
		},
		{
			"timestamps": {
				"from": "00:09:39,020",
				"to": "00:09:45,080"
			},
			"offsets": {
				"from": 579020,
				"to": 585080
			},
			"text": " I think when we get matured in our faith,"
		},
		{
			"timestamps": {
				"from": "00:09:45,080",
				"to": "00:09:48,820"
			},
			"offsets": {
				"from": 585080,
				"to": 588820
			},
			"text": " you begin looking for opportunities for life."
		},
		{
			"timestamps": {
				"from": "00:09:48,820",
				"to": "00:09:50,300"
			},
			"offsets": {
				"from": 588820,
				"to": 590300
			},
			"text": " Because you recognize,"
		},
		{
			"timestamps": {
				"from": "00:09:50,820",
				"to": "00:09:53,240"
			},
			"offsets": {
				"from": 590820,
				"to": 593240
			},
			"text": " there's something really good"
		},
		{
			"timestamps": {
				"from": "00:09:53,240",
				"to": "00:09:58,520"
			},
			"offsets": {
				"from": 593240,
				"to": 598520
			},
			"text": " about responding in love to somebody who has a need."
		},
		{
			"timestamps": {
				"from": "00:09:58,520",
				"to": "00:10:01,160"
			},
			"offsets": {
				"from": 598520,
				"to": 601160
			},
			"text": " I have to think of it this way."
		},
		{
			"timestamps": {
				"from": "00:10:01,160",
				"to": "00:10:03,000"
			},
			"offsets": {
				"from": 601160,
				"to": 603000
			},
			"text": " At least this has been my experience."
		},
		{
			"timestamps": {
				"from": "00:10:03,000",
				"to": "00:10:06,940"
			},
			"offsets": {
				"from": 603000,
				"to": 606940
			},
			"text": " It's like it resonates with my soul."
		},
		{
			"timestamps": {
				"from": "00:10:06,940",
				"to": "00:10:10,100"
			},
			"offsets": {
				"from": 606940,
				"to": 610100
			},
			"text": " It's more than just feels good."
		},
		{
			"timestamps": {
				"from": "00:10:10,100",
				"to": "00:10:13,320"
			},
			"offsets": {
				"from": 610100,
				"to": 613320
			},
			"text": " If I'm going to be done,"
		},
		{
			"timestamps": {
				"from": "00:10:13,320",
				"to": "00:10:15,740"
			},
			"offsets": {
				"from": 613320,
				"to": 615740
			},
			"text": " it really matters."
		},
		{
			"timestamps": {
				"from": "00:10:15,740",
				"to": "00:10:18,380"
			},
			"offsets": {
				"from": 615740,
				"to": 618380
			},
			"text": " But here's the thing."
		},
		{
			"timestamps": {
				"from": "00:10:18,840",
				"to": "00:10:21,140"
			},
			"offsets": {
				"from": 618840,
				"to": 621140
			},
			"text": " Sometimes I do something and I'm like,"
		},
		{
			"timestamps": {
				"from": "00:10:21,140",
				"to": "00:10:22,200"
			},
			"offsets": {
				"from": 621140,
				"to": 622200
			},
			"text": " well, that was okay."
		},
		{
			"timestamps": {
				"from": "00:10:22,200",
				"to": "00:10:23,740"
			},
			"offsets": {
				"from": 622200,
				"to": 623740
			},
			"text": " I didn't have to meet every day."
		},
		{
			"timestamps": {
				"from": "00:10:23,740",
				"to": "00:10:24,220"
			},
			"offsets": {
				"from": 623740,
				"to": 624220
			},
			"text": " I didn't see any beauty."
		},
		{
			"timestamps": {
				"from": "00:10:24,220",
				"to": "00:10:25,560"
			},
			"offsets": {
				"from": 624220,
				"to": 625560
			},
			"text": " I'm sure I didn't do all."
		},
		{
			"timestamps": {
				"from": "00:10:25,560",
				"to": "00:10:27,640"
			},
			"offsets": {
				"from": 625560,
				"to": 627640
			},
			"text": " It was just something else to do."
		},
		{
			"timestamps": {
				"from": "00:10:27,640",
				"to": "00:10:28,040"
			},
			"offsets": {
				"from": 627640,
				"to": 628040
			},
			"text": " I do it."
		},
		{
			"timestamps": {
				"from": "00:10:28,040",
				"to": "00:10:28,760"
			},
			"offsets": {
				"from": 628040,
				"to": 628760
			},
			"text": " Whatever."
		},
		{
			"timestamps": {
				"from": "00:10:28,760",
				"to": "00:10:32,520"
			},
			"offsets": {
				"from": 628760,
				"to": 632520
			},
			"text": " Because other times where I do something,"
		},
		{
			"timestamps": {
				"from": "00:10:32,520",
				"to": "00:10:35,200"
			},
			"offsets": {
				"from": 632520,
				"to": 635200
			},
			"text": " I think, oh, this is going to be more good."
		},
		{
			"timestamps": {
